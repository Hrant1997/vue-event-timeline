{
  "name": "vue-event-timeline",
  "version": "0.2.2",
  "description": "A lightweight, customizable event timeline component for Vue 3",
  "main": "./dist/vue-event-timeline.umd.js",
  "module": "./dist/vue-event-timeline.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-event-timeline.mjs",
      "require": "./dist/vue-event-timeline.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite --config vite.playground.config.ts --host",
    "playground": "vite --config vite.playground.config.ts",
    "build:playground": "vite build --config vite.playground.build.config.ts",
    "deploy:demo": "npm run build:playground && npx --yes gh-pages -d docs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"test/**/*.ts\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@vueuse/core": ">=10.0.0",
    "dayjs": "^1.11.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^14.4.0",
    "dayjs": "^1.11.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^4.1.11",
    "vue": "^3.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "license": "MIT",
  "author": "Hrant Yepiskoposyan",
  "keywords": [
    "vue",
    "vue3",
    "timeline",
    "gantt",
    "calendar",
    "scheduler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hrant1997/vue-event-timeline.git"
  }
}
